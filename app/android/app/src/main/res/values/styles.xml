<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:textSelectHandle">@drawable/text_select_handle_transparent</item>
        <item name="android:textSelectHandleLeft">@drawable/text_select_handle_transparent</item>
        <item name="android:textSelectHandleRight">@drawable/text_select_handle_transparent</item>
        <item name="android:alertDialogTheme">@style/AppTheme.LightDialog</item>
        <item name="android:datePickerDialogTheme">@style/AppTheme.LightDialog</item>
        <item name="android:timePickerDialogTheme">@style/AppTheme.LightDialog</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:textSelectHandle">@drawable/text_select_handle_transparent</item>
        <item name="android:textSelectHandleLeft">@drawable/text_select_handle_transparent</item>
        <item name="android:textSelectHandleRight">@drawable/text_select_handle_transparent</item>
        <item name="android:alertDialogTheme">@style/AppTheme.LightDialog</item>
        <item name="android:datePickerDialogTheme">@style/AppTheme.LightDialog</item>
        <item name="android:timePickerDialogTheme">@style/AppTheme.LightDialog</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/app_navy</item>
        <item name="android:background">@color/app_navy</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.LightDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">@color/app_navy</item>
        <item name="android:textColorSecondary">#6F7392</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Edge-to-Edge compatible launch theme for SDK 35+ -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowSplashScreenBackground">@color/app_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowBackground">@color/app_navy</item>
        <item name="android:background">@color/app_navy</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
