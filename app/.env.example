# Family sharing is locked for the first Play Store release.
# Set this to true later when the optional Supabase sharing flow is ready.
VITE_ENABLE_FAMILY_SHARING=false

# Supabase is only required when VITE_ENABLE_FAMILY_SHARING=true.
# Local-only scheduling works without these two values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ENABLE_SUPPORT=false
